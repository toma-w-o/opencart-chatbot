                <fieldset>
                  <legend><i class="fa fa-paper-plane"></i> {{ text_tg_privacy }}</legend>
                  <div class="form-group">
                    <label class="col-sm-2 control-label" for="input-s{{ sid }}-tgmask">{{ entry_tg_mask }}</label>
                    <div class="col-sm-4">
                      <select name="s[{{ sid }}][s_tg_mask]" id="input-s{{ sid }}-tgmask" class="form-control">
                        <option value="0"{% if not s.s_tg_mask %} selected="selected"{% endif %}>{{ text_tg_mask_off }}</option>
                        <option value="1"{% if s.s_tg_mask %} selected="selected"{% endif %}>{{ text_tg_mask_on }}</option>
                      </select>
                    </div>
                    <div class="col-sm-6"><div class="help-block" style="padding-top:2px">{{ help_tg_mask }}</div></div>
                  </div>
                  <div class="form-group">
                    <label class="col-sm-2 control-label" for="input-s{{ sid }}-tgdel">{{ entry_tg_delete_days }}</label>
                    <div class="col-sm-4">
                      <div class="input-group"><input type="text" name="s[{{ sid }}][s_tg_delete_days]" value="{{ s.s_tg_delete_days|e('html_attr') }}" id="input-s{{ sid }}-tgdel" class="form-control" data-default="7" /><span class="input-group-addon">{{ text_unit_days }}</span></div>
                      {% if errors[p ~ 's_tg_delete_days'] %}<div class="text-danger aichat-err">{{ errors[p ~ 's_tg_delete_days'] }}</div>{% endif %}
                    </div>
                    <div class="col-sm-6"><div class="help-block" style="padding-top:2px">{{ help_tg_delete_days }}</div></div>
                  </div>
                </fieldset>
              </div>
              {% endfor %}
            </div>

          </div>
      </div>
    </div>
    </form>
    {% if can_modify %}
    <div class="panel panel-danger aichat-card" id="aichat-purge">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-trash"></i> {{ text_purge_title }}</h3></div>
      <div class="panel-body">
        <p>{{ text_purge_help }}</p>
        <form action="{{ purge_action }}" method="post" class="form-inline">
          <div class="form-group"><input type="text" name="confirm" value="" class="form-control" placeholder="{{ purge_word }}" autocomplete="off" /></div>
          <button type="submit" class="btn btn-danger"><i class="fa fa-trash"></i> {{ button_purge }}</button>
        </form>
      </div>
    </div>
    {% endif %}
  </div>
</div>
{{ footer }}
