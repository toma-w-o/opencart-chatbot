{{ header }}{{ column_left }}
<div id="content" class="aichat-admin">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-aichat" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {{ subnav }}
    {% if upgrade_pending %}<div class="alert alert-warning"><i class="fa fa-info-circle"></i> {{ text_upgrade_pending }}</div>{% endif %}
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if storage_exposed %}<div class="alert alert-danger"><i class="fa fa-exclamation-triangle"></i> {{ text_storage_exposed }}{% if storage_path %} <code>{{ storage_path|e }}</code>{% endif %}</div>{% elseif storage_unknown %}<div class="alert alert-warning"><i class="fa fa-exclamation-triangle"></i> {{ text_storage_unknown }}{% if storage_path %} <code>{{ storage_path|e }}</code>{% endif %}</div>{% endif %}
    <div class="alert alert-info"><i class="fa fa-user-secret"></i> {{ text_privacy_access }}</div>
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-aichat" class="form-horizontal" data-start-tab="{{ start_tab }}" data-privacy-link="{{ text_privacy_link|e('html_attr') }}">
    <div class="panel panel-default aichat-card">
      <div class="panel-body">
          <ul class="nav nav-tabs aichat-tabs" id="aichat-tabs">
            <li class="active"><a href="#tab-general" data-toggle="tab">{{ tab_general }}</a></li>
            <li><a href="#tab-protection" data-toggle="tab">{{ tab_protection }}</a></li>
            <li><a href="#tab-couriers" data-toggle="tab">{{ tab_couriers }}</a></li>
            <li><a href="#tab-telegram" data-toggle="tab"><i class="fa fa-paper-plane"></i> {{ tab_telegram }}</a></li>
            <li class="aichat-tab-store"><a href="#tab-assistant" data-toggle="tab">{{ tab_assistant }}</a></li>
            <li class="aichat-tab-store"><a href="#tab-appearance" data-toggle="tab">{{ tab_appearance }}</a></li>
            <li class="aichat-tab-store"><a href="#tab-contacts" data-toggle="tab">{{ tab_contacts }}</a></li>
            <li class="aichat-tab-store"><a href="#tab-orders" data-toggle="tab">{{ tab_orders }}</a></li>
            <li class="aichat-tab-store"><a href="#tab-behaviour" data-toggle="tab">{{ tab_behaviour }}</a></li>
            <li class="aichat-tab-store"><a href="#tab-limits" data-toggle="tab">{{ tab_limits }}</a></li>
            <li class="aichat-tab-store"><a href="#tab-privacy" data-toggle="tab"><i class="fa fa-user-secret"></i> {{ tab_privacy }}</a></li>
          </ul>

          <div class="aichat-storebar" id="aichat-storebar" style="display:none">
            <i class="fa fa-shopping-bag"></i> <strong>{{ text_store }}:</strong>
            <select id="aichat-store-select" class="form-control input-sm">
              {% for store in stores %}<option value="{{ store.store_id }}">{{ store.name|e }}</option>{% endfor %}
            </select>
            <span class="text-muted">{{ text_store_note }}</span>
            <button type="button" class="btn btn-default btn-sm pull-right" id="aichat-reset-store" data-confirm="{{ text_reset_confirm|e('html_attr') }}"><i class="fa fa-undo"></i> {{ button_reset_store }}</button>
          </div>

          <div class="tab-content">

            <!-- ============ GENERAL ============ -->
            <div class="tab-pane active" id="tab-general">
              <p class="text-muted">{{ text_global_note }}</p>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-api-key">{{ entry_api_key }}</label>
                <div class="col-sm-10">
                  <input type="password" name="api_key" value="" placeholder="{{ has_key ? text_key_set : text_key_not_set }}" id="input-api-key" class="form-control" autocomplete="new-password" />
                  <div class="help-block">
                    {% if has_key %}<span class="label label-success">{{ text_key_set }}</span>{% else %}<span class="label label-warning">{{ text_key_not_set }}</span>{% endif %}
                    {{ text_key_help }}
                  </div>
                </div>
              </div>
              <div class="form-group required">
                <label class="col-sm-2 control-label" for="input-g-model">{{ entry_model }}</label>
                <div class="col-sm-10">
                  <input type="text" name="g[g_model]" value="{{ g.g_model|e('html_attr') }}" id="input-g-model" class="form-control" />
                  {% if errors.g_model %}<div class="text-danger">{{ errors.g_model }}</div>{% endif %}
                  <div class="help-block">{{ help_model }}</div>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-g-model-light">{{ entry_model_light }}</label>
                <div class="col-sm-4">
                  <input type="text" name="g[g_model_light]" value="{{ g.g_model_light|e('html_attr') }}" id="input-g-model-light" class="form-control" />
                </div>
                <div class="col-sm-6"><div class="help-block" style="padding-top:8px">{{ help_model_light }}</div></div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-g-timezone">{{ entry_timezone }}</label>
                <div class="col-sm-4">
                  <input type="text" name="g[g_timezone]" value="{{ g.g_timezone|e('html_attr') }}" id="input-g-timezone" class="form-control" placeholder="Europe/Sofia" />
                </div>
                <div class="col-sm-6"><div class="help-block" style="padding-top:8px">{{ help_timezone }}</div></div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-g-instructions">{{ entry_instructions }}</label>
                <div class="col-sm-10">
                  <textarea name="g[g_instructions]" rows="6" id="input-g-instructions" class="form-control">{{ g.g_instructions|e }}</textarea>
                  <div class="help-block">{{ help_instructions }}</div>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-g-price-in">{{ entry_price_in }}</label>
                <div class="col-sm-4">
                  <div class="input-group"><input type="text" name="g[g_price_in]" value="{{ g.g_price_in|e('html_attr') }}" id="input-g-price-in" class="form-control" /><span class="input-group-addon">USD / 1M</span></div>
                  {% if errors.g_price_in %}<div class="text-danger">{{ errors.g_price_in }}</div>{% endif %}
                </div>
                <label class="col-sm-2 control-label" for="input-g-price-out">{{ entry_price_out }}</label>
                <div class="col-sm-4">
                  <div class="input-group"><input type="text" name="g[g_price_out]" value="{{ g.g_price_out|e('html_attr') }}" id="input-g-price-out" class="form-control" /><span class="input-group-addon">USD / 1M</span></div>
                  {% if errors.g_price_out %}<div class="text-danger">{{ errors.g_price_out }}</div>{% endif %}
                </div>
                <div class="col-sm-offset-2 col-sm-10"><div class="help-block">{{ text_price_help }}</div></div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-g-price-lin">{{ entry_price_light_in }}</label>
                <div class="col-sm-4">
                  <div class="input-group"><input type="text" name="g[g_price_light_in]" value="{{ g.g_price_light_in|e('html_attr') }}" id="input-g-price-lin" class="form-control" /><span class="input-group-addon">USD / 1M</span></div>
                  {% if errors.g_price_light_in %}<div class="text-danger">{{ errors.g_price_light_in }}</div>{% endif %}
                </div>
                <label class="col-sm-2 control-label" for="input-g-price-lout">{{ entry_price_light_out }}</label>
                <div class="col-sm-4">
                  <div class="input-group"><input type="text" name="g[g_price_light_out]" value="{{ g.g_price_light_out|e('html_attr') }}" id="input-g-price-lout" class="form-control" /><span class="input-group-addon">USD / 1M</span></div>
                  {% if errors.g_price_light_out %}<div class="text-danger">{{ errors.g_price_light_out }}</div>{% endif %}
                </div>
                <div class="col-sm-offset-2 col-sm-10"><div class="help-block">{{ help_price_light }}</div></div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-g-budget">{{ entry_budget_month }}</label>
                <div class="col-sm-4">
                  <div class="input-group"><input type="text" name="g[g_budget_month]" value="{{ g.g_budget_month|e('html_attr') }}" id="input-g-budget" class="form-control" /><span class="input-group-addon">USD</span></div>
                  {% if errors.g_budget_month %}<div class="text-danger">{{ errors.g_budget_month }}</div>{% endif %}
                </div>
                <label class="col-sm-2 control-label" for="input-g-warn">{{ entry_warn_email }}</label>
                <div class="col-sm-4">
                  <input type="text" name="g[g_warn_email]" value="{{ g.g_warn_email|e('html_attr') }}" id="input-g-warn" class="form-control" />
                  {% if errors.g_warn_email %}<div class="text-danger">{{ errors.g_warn_email }}</div>{% endif %}
                </div>
                <div class="col-sm-offset-2 col-sm-10"><div class="help-block">{{ text_budget_help }} {{ help_warn_email }}</div></div>
              </div>
              <fieldset id="aichat-retention">
                <legend>{{ text_retention_title }}</legend>
                <div class="help-block aichat-legend-help">{{ help_retention_intro }}</div>
                <div class="form-group">
                  <label class="col-sm-3 control-label" for="input-g_retention_months">{{ entry_retention_months }}</label>
                  <div class="col-sm-3">
                    <div class="input-group"><input type="text" name="g[g_retention_months]" value="{{ g.g_retention_months|e('html_attr') }}" id="input-g_retention_months" class="form-control aichat-retention" data-warn="12" /><span class="input-group-addon">{{ text_unit_months }}</span></div>
                    {% if errors.g_retention_months %}<div class="text-danger">{{ errors.g_retention_months }}</div>{% endif %}
                    <div class="text-warning aichat-retention-warn" style="display:none"><i class="fa fa-exclamation-triangle"></i> {{ text_retention_long }}</div>
                  </div>
                  <div class="col-sm-6"><div class="help-block" style="padding-top:8px">{{ help_retention_conv }}</div></div>
                </div>
                <div class="form-group">
                  <label class="col-sm-3 control-label" for="input-g_ip_days">{{ entry_ip_days }}</label>
                  <div class="col-sm-3">
                    <div class="input-group"><input type="text" name="g[g_ip_days]" value="{{ g.g_ip_days|e('html_attr') }}" id="input-g_ip_days" class="form-control aichat-retention" data-warn="365" /><span class="input-group-addon">{{ text_unit_days }}</span></div>
                    {% if errors.g_ip_days %}<div class="text-danger">{{ errors.g_ip_days }}</div>{% endif %}
                    <div class="text-warning aichat-retention-warn" style="display:none"><i class="fa fa-exclamation-triangle"></i> {{ text_retention_long }}</div>
                  </div>
                  <div class="col-sm-6"><div class="help-block" style="padding-top:8px">{{ help_ip_days }}</div></div>
                </div>
                <div class="form-group">
                  <label class="col-sm-3 control-label" for="input-g_image_retention_days">{{ entry_image_retention_days }}</label>
                  <div class="col-sm-3">
                    <div class="input-group"><input type="text" name="g[g_image_retention_days]" value="{{ g.g_image_retention_days|e('html_attr') }}" id="input-g_image_retention_days" class="form-control aichat-retention" data-warn="365" /><span class="input-group-addon">{{ text_unit_days }}</span></div>
                    {% if errors.g_image_retention_days %}<div class="text-danger">{{ errors.g_image_retention_days }}</div>{% endif %}
                    <div class="text-warning aichat-retention-warn" style="display:none"><i class="fa fa-exclamation-triangle"></i> {{ text_retention_long }}</div>
                  </div>
                  <div class="col-sm-6"><div class="help-block" style="padding-top:8px">{{ help_image_days }}</div></div>
                </div>
                <div class="form-group">
                  <label class="col-sm-3 control-label" for="input-g_request_months">{{ entry_request_months }}</label>
                  <div class="col-sm-3">
                    <div class="input-group"><input type="text" name="g[g_request_months]" value="{{ g.g_request_months|e('html_attr') }}" id="input-g_request_months" class="form-control aichat-retention" data-warn="12" /><span class="input-group-addon">{{ text_unit_months }}</span></div>
                    {% if errors.g_request_months %}<div class="text-danger">{{ errors.g_request_months }}</div>{% endif %}
                    <div class="text-warning aichat-retention-warn" style="display:none"><i class="fa fa-exclamation-triangle"></i> {{ text_retention_long }}</div>
                  </div>
                  <div class="col-sm-6"><div class="help-block" style="padding-top:8px">{{ help_request_months }}</div></div>
                </div>
                <div class="form-group">
                  <label class="col-sm-3 control-label" for="input-g_miss_days">{{ entry_miss_days }}</label>
                  <div class="col-sm-3">
                    <div class="input-group"><input type="text" name="g[g_miss_days]" value="{{ g.g_miss_days|e('html_attr') }}" id="input-g_miss_days" class="form-control aichat-retention" data-warn="365" /><span class="input-group-addon">{{ text_unit_days }}</span></div>
                    {% if errors.g_miss_days %}<div class="text-danger">{{ errors.g_miss_days }}</div>{% endif %}
                    <div class="text-warning aichat-retention-warn" style="display:none"><i class="fa fa-exclamation-triangle"></i> {{ text_retention_long }}</div>
                  </div>
                  <div class="col-sm-6"><div class="help-block" style="padding-top:8px">{{ help_miss_days }}</div></div>
                </div>
              </fieldset>
              <fieldset>
                <legend>{{ text_weekly_report }}</legend>
                <div class="form-group">
                  <label class="col-sm-2 control-label">{{ entry_report_weekly }}</label>
                  <div class="col-sm-4">
                    <input type="hidden" name="g[g_report_weekly]" value="0" />
                    <label class="aichat-switch"><input type="checkbox" name="g[g_report_weekly]" value="1"{% if g.g_report_weekly %} checked="checked"{% endif %} /> {{ text_enabled }}</label>
                  </div>
                  <label class="col-sm-2 control-label" for="input-g-report-email">{{ entry_report_email }}</label>
                  <div class="col-sm-4">
                    <input type="text" name="g[g_report_email]" value="{{ g.g_report_email|e('html_attr') }}" id="input-g-report-email" class="form-control" />
                    {% if errors.g_report_email %}<div class="text-danger">{{ errors.g_report_email }}</div>{% endif %}
                  </div>
                  <div class="col-sm-offset-2 col-sm-10"><div class="help-block">{{ help_report }}</div></div>
                </div>
              </fieldset>
            </div>

            <!-- ============ PROTECTION ============ -->
            <div class="tab-pane" id="tab-protection">
              <p class="text-muted">{{ text_global_note }}</p>
              <fieldset>
                <legend>Cloudflare Turnstile</legend>
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-g-ts-site">{{ entry_turnstile_site }}</label>
                  <div class="col-sm-4"><input type="text" name="g[g_turnstile_site]" value="{{ g.g_turnstile_site|e('html_attr') }}" id="input-g-ts-site" class="form-control" /></div>
                  <label class="col-sm-2 control-label" for="input-g-ts-secret">{{ entry_turnstile_secret }}</label>
                  <div class="col-sm-4"><input type="password" name="ts_secret" value="" placeholder="{{ ts_has_secret ? text_saved : text_key_not_set }}" id="input-g-ts-secret" class="form-control" autocomplete="new-password" />
                    {% if ts_has_secret %}<label class="aichat-switch" style="margin-top:6px"><input type="checkbox" name="ts_secret_clear" value="1" /> {{ text_ts_secret_clear }}</label>{% endif %}</div>
                  <div class="col-sm-offset-2 col-sm-10"><div class="help-block">{{ help_turnstile }}</div></div>
                </div>
              </fieldset>
              <fieldset>
                <legend>{{ text_network }}</legend>
                <div class="form-group">
                  <label class="col-sm-2 control-label">{{ entry_trust_cf_ip }}</label>
                  <div class="col-sm-10">
                    <label class="aichat-switch"><input type="checkbox" name="g[g_trust_cf_ip]" value="1"{% if g.g_trust_cf_ip %} checked="checked"{% endif %} /> {{ text_enabled }}</label>
                    <div class="help-block">{{ help_trust_cf_ip }}</div>
                  </div>
                </div>
              </fieldset>
              <fieldset>
                <legend>{{ tab_limits }}</legend>
                <p class="text-muted">{{ help_limits_link }} <a href="#tab-limits" class="aichat-goto-tab">{{ tab_limits }} &rarr;</a></p>
              </fieldset>
            </div>

            <!-- ============ COURIERS ============ -->
            <div class="tab-pane" id="tab-couriers">
              <p class="text-muted">{{ text_global_note }} {{ help_couriers }}</p>
              {% if not courier_secrets_supported %}<div class="alert alert-warning">{{ text_courier_secret_unavailable }}</div>{% endif %}
              <div id="aichat-couriers">
                {% for c in couriers %}
                <div class="aichat-courier panel panel-default" data-idx="{{ c.idx }}">
                  <div class="panel-body">
                    <button type="button" class="close aichat-courier-del" title="{{ button_remove }}">&times;</button>
                    <div class="row">
                      <div class="col-sm-3"><label>{{ entry_courier_name }}</label><input type="text" name="couriers[{{ c.idx }}][name]" value="{{ c.name|e('html_attr') }}" class="form-control" /></div>
                      <div class="col-sm-2"><label>{{ entry_courier_code }}</label><input type="text" name="couriers[{{ c.idx }}][code]" value="{{ c.code|e('html_attr') }}" class="form-control" placeholder="speedy" /></div>
                      <div class="col-sm-2"><label>{{ entry_courier_type }}</label>
                        <select name="couriers[{{ c.idx }}][type]" class="form-control aichat-courier-type">
                          <option value="speedy"{% if c.type == 'speedy' %} selected="selected"{% endif %}>Speedy (API)</option>
                          <option value="link"{% if c.type == 'link' %} selected="selected"{% endif %}>{{ text_type_link }}</option>
                        </select></div>
                      <div class="col-sm-5"><label>{{ entry_courier_hosts }}</label><input type="text" name="couriers[{{ c.idx }}][hosts]" value="{{ c.hosts|e('html_attr') }}" class="form-control" placeholder="speedy.bg, www.speedy.bg" /></div>
                    </div>
                    <div class="row">
                      <div class="col-sm-12"><label>{{ entry_courier_url }}</label><input type="text" name="couriers[{{ c.idx }}][track_url]" value="{{ c.track_url|e('html_attr') }}" class="form-control" placeholder="https://www.speedy.bg/bg/track-shipment?shipmentNumber={number}" /></div>
                    </div>
                    <details class="aichat-courier-adv"{% if c.advanced and errors['courier_' ~ c.idx] %} open{% endif %}>
                      <summary>{{ text_courier_advanced }}</summary>
                      <div class="row">
                        <div class="col-sm-6"><label>{{ entry_courier_pattern }}</label><input type="text" name="couriers[{{ c.idx }}][pattern]" value="{{ c.pattern|e('html_attr') }}" class="form-control aichat-mono" placeholder="^6\d{10}$" /><p class="help-block">{{ help_courier_pattern }}</p></div>
                        <div class="col-sm-6"><label>{{ entry_courier_aliases }}</label><input type="text" name="couriers[{{ c.idx }}][aliases]" value="{{ c.aliases|e('html_attr') }}" class="form-control" placeholder="Спиди, Speedy" /><p class="help-block">{{ help_courier_aliases }}</p></div>
                      </div>
                    </details>
                    <div class="row aichat-courier-secret">
                      <div class="col-sm-4"><label>{{ entry_courier_user }}</label><input type="text" name="courier_secret[{{ c.idx }}][username]" value="" class="form-control" autocomplete="off" placeholder="{{ c.secret ? text_saved : '' }}" /></div>
                      <div class="col-sm-4"><label>{{ entry_courier_pass }}</label><input type="password" name="courier_secret[{{ c.idx }}][password]" value="" class="form-control" autocomplete="new-password" placeholder="{{ c.secret ? text_saved : '' }}" /></div>
                      <div class="col-sm-4"><p class="help-block">{% if c.secret %}<span class="label label-success">{{ text_saved }}</span> {% endif %}{{ help_courier_secret }}</p></div>
                    </div>
                    {% if errors['courier_' ~ c.idx] %}<div class="text-danger">{{ errors['courier_' ~ c.idx] }}</div>{% endif %}
                  </div>
                </div>
                {% endfor %}
              </div>
              <button type="button" class="btn btn-success" id="aichat-courier-add"><i class="fa fa-plus"></i> {{ button_add_courier }}</button>
              <template id="aichat-courier-tpl">
                <div class="aichat-courier panel panel-default" data-idx="__I__">
                  <div class="panel-body">
                    <button type="button" class="close aichat-courier-del" title="{{ button_remove }}">&times;</button>
                    <div class="row">
                      <div class="col-sm-3"><label>{{ entry_courier_name }}</label><input type="text" name="couriers[__I__][name]" value="" class="form-control" /></div>
                      <div class="col-sm-2"><label>{{ entry_courier_code }}</label><input type="text" name="couriers[__I__][code]" value="" class="form-control" placeholder="speedy" /></div>
                      <div class="col-sm-2"><label>{{ entry_courier_type }}</label>
                        <select name="couriers[__I__][type]" class="form-control aichat-courier-type">
                          <option value="speedy">Speedy (API)</option>
                          <option value="link" selected="selected">{{ text_type_link }}</option>
                        </select></div>
                      <div class="col-sm-5"><label>{{ entry_courier_hosts }}</label><input type="text" name="couriers[__I__][hosts]" value="" class="form-control" placeholder="speedy.bg, www.speedy.bg" /></div>
                    </div>
                    <div class="row">
                      <div class="col-sm-12"><label>{{ entry_courier_url }}</label><input type="text" name="couriers[__I__][track_url]" value="" class="form-control" placeholder="https://example.com/track?number={number}" /></div>
                    </div>
                    <details class="aichat-courier-adv">
                      <summary>{{ text_courier_advanced }}</summary>
                      <div class="row">
                        <div class="col-sm-6"><label>{{ entry_courier_pattern }}</label><input type="text" name="couriers[__I__][pattern]" value="" class="form-control aichat-mono" placeholder="^1000\d{9}$" /><p class="help-block">{{ help_courier_pattern }}</p></div>
                        <div class="col-sm-6"><label>{{ entry_courier_aliases }}</label><input type="text" name="couriers[__I__][aliases]" value="" class="form-control" /><p class="help-block">{{ help_courier_aliases }}</p></div>
                      </div>
                    </details>
                    <div class="row aichat-courier-secret">
                      <div class="col-sm-4"><label>{{ entry_courier_user }}</label><input type="text" name="courier_secret[__I__][username]" value="" class="form-control" autocomplete="off" /></div>
                      <div class="col-sm-4"><label>{{ entry_courier_pass }}</label><input type="password" name="courier_secret[__I__][password]" value="" class="form-control" autocomplete="new-password" /></div>
                      <div class="col-sm-4"><p class="help-block">{{ help_courier_secret }}</p></div>
                    </div>
                  </div>
                </div>
              </template>
            </div>

            <!-- ============ TELEGRAM (global) ============ -->
            <div class="tab-pane" id="tab-telegram">
              <p class="text-muted">{{ text_global_note }} {{ help_telegram }}</p>
              {% if not tg_supported %}<div class="alert alert-warning">{{ text_tg_unavailable }}</div>{% endif %}

              <div class="panel panel-default aichat-howto">
                <div class="panel-heading"><a data-toggle="collapse" href="#aichat-tg-howto"><i class="fa fa-question-circle"></i> {{ text_tg_howto_title }} <i class="fa fa-caret-down"></i></a></div>
                <div id="aichat-tg-howto" class="panel-collapse collapse in">
                  <div class="panel-body">
                    <ol class="aichat-steps">
                      <li>{{ text_tg_step1 }}</li>
                      <li>{{ text_tg_step2 }}</li>
                      <li>{{ text_tg_step3 }}</li>
                      <li>{{ text_tg_step4 }}</li>
                      <li>{{ text_tg_step5 }}</li>
                      <li>{{ text_tg_step6 }}</li>
                      <li>{{ text_tg_step7 }}</li>
                    </ol>
                    <p class="help-block">{{ text_tg_howto_flow }}</p>
                  </div>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-tg-token">{{ entry_tg_token }}</label>
                <div class="col-sm-10">
                  <input type="password" name="tg_token" value="" placeholder="{{ tg_has_token ? text_saved : text_key_not_set }}" id="input-tg-token" class="form-control" autocomplete="new-password" />
                  {% if errors.tg_token %}<div class="text-danger">{{ errors.tg_token }}</div>{% endif %}
                  <div class="help-block">
                    {% if tg_has_token %}<span class="label label-success">{{ text_saved }}</span>{% else %}<span class="label label-warning">{{ text_key_not_set }}</span>{% endif %}
                    {{ help_tg_token }}
                    {% if tg_has_token %}<label class="aichat-switch" style="margin-left:10px"><input type="checkbox" name="tg_token_clear" value="1" /> {{ text_tg_token_clear }}</label>{% endif %}
                  </div>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-tg-chat">{{ entry_tg_chat }}</label>
                <div class="col-sm-4">
                  <input type="text" name="g[g_tg_chat_id]" value="{{ g.g_tg_chat_id|e('html_attr') }}" id="input-tg-chat" class="form-control" placeholder="-1001234567890" />
                  {% if errors.g_tg_chat_id %}<div class="text-danger">{{ errors.g_tg_chat_id }}</div>{% endif %}
                </div>
                <div class="col-sm-6"><div class="help-block" style="padding-top:8px">{{ help_tg_chat }}</div></div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label">{{ text_tg_connect }}</label>
                <div class="col-sm-10">
                  <button type="button" class="btn btn-primary" id="aichat-tg-webhook" data-url="{{ tg_webhook_url }}"><i class="fa fa-plug"></i> {{ button_tg_webhook }}</button>
                  <button type="button" class="btn btn-default" id="aichat-tg-test" data-url="{{ tg_test_url }}"><i class="fa fa-paper-plane-o"></i> {{ button_tg_test }}</button>
                  <span id="aichat-tg-result" class="aichat-tg-result"></span>
                  <div class="help-block">{{ help_tg_buttons }} <code>{{ tg_catalog|e }}</code>{% if not tg_https %} <span class="text-warning"><i class="fa fa-exclamation-triangle"></i> {{ text_tg_https }}</span>{% endif %}</div>
                </div>
              </div>

              <fieldset>
                <legend>{{ text_tg_translate }}</legend>
                <div class="form-group">
                  <label class="col-sm-2 control-label">{{ entry_tg_translate }}</label>
                  <div class="col-sm-4">
                    <input type="hidden" name="g[g_tg_translate]" value="0" />
                    <label class="aichat-switch"><input type="checkbox" name="g[g_tg_translate]" value="1"{% if g.g_tg_translate %} checked="checked"{% endif %} /> {{ text_enabled }}</label>
                  </div>
                  <label class="col-sm-2 control-label" for="input-tg-lang">{{ entry_tg_staff_lang }}</label>
                  <div class="col-sm-4">
                    <select name="g[g_tg_staff_lang]" id="input-tg-lang" class="form-control">
                      {% for code, name in staff_langs %}<option value="{{ code|e('html_attr') }}"{% if g.g_tg_staff_lang == code %} selected="selected"{% endif %}>{{ name|e }}</option>{% endfor %}
                    </select>
                  </div>
                  <div class="col-sm-offset-2 col-sm-10"><div class="help-block">{{ help_tg_translate }}</div></div>
                </div>
              </fieldset>

              <fieldset>
                <legend>{{ text_tg_staff_ids }}</legend>
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-tg-staff-ids">{{ entry_tg_staff_ids }}</label>
                  <div class="col-sm-4">
                    <textarea name="g[g_tg_staff_ids]" rows="4" id="input-tg-staff-ids" class="form-control aichat-mono" placeholder="123456789">{{ tg_staff_ids|e }}</textarea>
                    {% if errors.tg_staff_ids %}<div class="text-danger">{{ errors.tg_staff_ids }}</div>{% endif %}
                  </div>
                  <div class="col-sm-6">
                    <div class="help-block">{{ help_tg_staff_ids }}</div>
                    {% if tg_takers %}
                    <table class="table table-condensed aichat-small"><thead><tr><th>{{ text_tg_taker }}</th><th>ID</th><th>{{ text_date }}</th></tr></thead><tbody>
                      {% for t in tg_takers %}<tr><td>{{ t.name|e }}</td><td><code>{{ t.id|e }}</code></td><td>{{ t.date|e }}</td></tr>{% endfor %}
                    </tbody></table>
                    {% endif %}
                  </div>
                </div>
              </fieldset>

              <fieldset>
                <legend>{{ text_tg_canned }}</legend>
                <p class="help-block">{{ help_tg_canned }}</p>
                {% if errors.canned %}<div class="text-danger aichat-err">{{ errors.canned }}</div>{% endif %}
                <div id="aichat-canned">
                  {% for c in canned %}
                  <div class="aichat-canned row" data-idx="{{ c.idx }}">
                    <div class="col-sm-3"><div class="input-group"><span class="input-group-addon">/</span><input type="text" name="g[g_tg_canned][{{ c.idx }}][code]" value="{{ c.code|e('html_attr') }}" class="form-control" placeholder="{{ text_tg_canned_code }}" maxlength="32" /></div></div>
                    <div class="col-sm-8"><textarea name="g[g_tg_canned][{{ c.idx }}][text]" rows="2" class="form-control" placeholder="{{ text_tg_canned_text }}">{{ c.text|e }}</textarea></div>
                    <div class="col-sm-1"><button type="button" class="btn btn-danger btn-sm aichat-canned-del" title="{{ button_remove }}"><i class="fa fa-minus-circle"></i></button></div>
                  </div>
                  {% endfor %}
                </div>
                <button type="button" class="btn btn-success btn-sm" id="aichat-canned-add"><i class="fa fa-plus"></i> {{ button_add_canned }}</button>
                <template id="aichat-canned-tpl">
                  <div class="aichat-canned row" data-idx="__I__">
                    <div class="col-sm-3"><div class="input-group"><span class="input-group-addon">/</span><input type="text" name="g[g_tg_canned][__I__][code]" value="" class="form-control" placeholder="{{ text_tg_canned_code }}" maxlength="32" /></div></div>
                    <div class="col-sm-8"><textarea name="g[g_tg_canned][__I__][text]" rows="2" class="form-control" placeholder="{{ text_tg_canned_text }}"></textarea></div>
                    <div class="col-sm-1"><button type="button" class="btn btn-danger btn-sm aichat-canned-del" title="{{ button_remove }}"><i class="fa fa-minus-circle"></i></button></div>
                  </div>
                </template>
              </fieldset>
              <p class="text-muted" style="margin-top:14px">{{ help_tg_store_link }} <a href="#tab-contacts" class="aichat-goto-tab">{{ tab_contacts }} &rarr;</a></p>
            </div>

            <!-- ============ ASSISTANT (per store) ============ -->
            <div class="tab-pane" id="tab-assistant">
              {% for store in stores %}{% set sid = store.store_id %}{% set s = store.s %}
              <div class="aichat-store" data-store="{{ sid }}">
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-s{{ sid }}-status">{{ entry_status }}</label>
                  <div class="col-sm-4">
                    <select name="s[{{ sid }}][s_status]" id="input-s{{ sid }}-status" class="form-control">
                      <option value="1"{% if s.s_status %} selected="selected"{% endif %}>{{ text_enabled }}</option>
                      <option value="0"{% if not s.s_status %} selected="selected"{% endif %}>{{ text_disabled }}</option>
                    </select>
                  </div>
                  <label class="col-sm-2 control-label" for="input-s{{ sid }}-name">{{ entry_bot_name }}</label>
                  <div class="col-sm-4"><input type="text" name="s[{{ sid }}][s_bot_name]" value="{{ s.s_bot_name|e('html_attr') }}" id="input-s{{ sid }}-name" class="form-control" />
                    <div class="help-block">{{ help_bot_name }}</div></div>
                </div>
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-s{{ sid }}-storename">{{ entry_store_name }}</label>
                  <div class="col-sm-4"><input type="text" name="s[{{ sid }}][s_store_name]" value="{{ s.s_store_name|e('html_attr') }}" id="input-s{{ sid }}-storename" class="form-control" maxlength="64" placeholder="{{ s.store_name_auto|e('html_attr') }}" />
                    <div class="help-block">{{ help_store_name|format(s.store_name_auto)|e }}</div></div>
                </div>
                <div class="form-group">
                  <label class="col-sm-2 control-label">{{ entry_avatar }}</label>
                  <div class="col-sm-10">
                    <div class="aichat-avatars">
                      {% for a in avatars %}
                      <label class="aichat-avatar" title="{{ a.name|e('html_attr') }}">
                        <input type="radio" name="s[{{ sid }}][s_avatar]" value="{{ a.id|e('html_attr') }}"{% if s.s_avatar == a.id %} checked="checked"{% endif %} />
                        <span class="aichat-avatar-box"><img src="{{ avatar_base ~ a.id }}.svg" alt="" loading="lazy" onerror="this.style.visibility='hidden'" /></span>
                        <span class="aichat-avatar-name">{{ a.name|e }}</span>
                      </label>
                      {% endfor %}
                    </div>
                    <div class="help-block">{{ help_avatar }}</div>
                  </div>
                </div>

                <fieldset>
                  <legend>{{ text_greeting }}</legend>
                  <div class="help-block aichat-legend-help">{{ help_greeting }}</div>
                  {% for language in languages %}
                  <div class="form-group">
                    <label class="col-sm-2 control-label" for="input-s{{ sid }}-greeting-{{ language.language_id }}">{{ language.name|e }}</label>
                    <div class="col-sm-10"><textarea name="s[{{ sid }}][s_greeting][{{ language.language_id }}]" rows="2" id="input-s{{ sid }}-greeting-{{ language.language_id }}" class="form-control" data-default="{{ factory.s_greeting[language.language_id]|e('html_attr') }}">{{ s.s_greeting[language.language_id]|e }}</textarea></div>
                  </div>
                  {% endfor %}
                </fieldset>

                <fieldset>
                  <legend>{{ text_welcome_back }}</legend>
                  <div class="help-block aichat-legend-help">{{ help_welcome_back }}</div>
                  {% for language in languages %}
                  <div class="form-group">
                    <label class="col-sm-2 control-label">{{ language.name|e }}</label>
                    <div class="col-sm-10"><input type="text" name="s[{{ sid }}][s_welcome_back][{{ language.language_id }}]" value="{{ s.s_welcome_back[language.language_id]|e('html_attr') }}" class="form-control" data-default="{{ factory.s_welcome_back[language.language_id]|e('html_attr') }}" /></div>
                  </div>
                  {% endfor %}
                </fieldset>

                <fieldset>
                  <legend>{{ text_quick_replies }}</legend>
                  <div class="help-block aichat-legend-help">{{ help_quick_replies }}</div>
                  {% for language in languages %}
                  <div class="form-group">
                    <label class="col-sm-2 control-label">{{ language.name|e }}</label>
                    <div class="col-sm-10"><textarea name="s[{{ sid }}][s_quick_replies][{{ language.language_id }}]" rows="3" class="form-control" data-default="{{ factory.s_quick_replies[language.language_id]|e('html_attr') }}">{{ s.s_quick_replies[language.language_id]|e }}</textarea></div>
                  </div>
                  {% endfor %}
                </fieldset>

                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-s{{ sid }}-instructions">{{ entry_store_instructions }}</label>
                  <div class="col-sm-10"><textarea name="s[{{ sid }}][s_instructions]" rows="5" id="input-s{{ sid }}-instructions" class="form-control">{{ s.s_instructions|e }}</textarea>
                    <div class="help-block">{{ help_store_instructions }}</div></div>
                </div>
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-s{{ sid }}-emoji">{{ entry_emoji }}</label>
                  <div class="col-sm-4">
                    <select name="s[{{ sid }}][s_emoji]" id="input-s{{ sid }}-emoji" class="form-control" data-default="1">
                      <option value="0"{% if s.s_emoji == 0 %} selected="selected"{% endif %}>{{ text_none }}</option>
                      <option value="1"{% if s.s_emoji == 1 %} selected="selected"{% endif %}>{{ text_moderate }}</option>
                      <option value="2"{% if s.s_emoji == 2 %} selected="selected"{% endif %}>{{ text_lots }}</option>
                    </select>
                  </div>
                  <label class="col-sm-2 control-label" for="input-s{{ sid }}-resume">{{ entry_resume_days }}</label>
                  <div class="col-sm-4">
                    <input type="text" name="s[{{ sid }}][s_resume_days]" value="{{ s.s_resume_days|e('html_attr') }}" id="input-s{{ sid }}-resume" class="form-control" data-default="7" />
                    {% if errors['s_' ~ sid ~ '_s_resume_days'] %}<div class="text-danger aichat-err">{{ errors['s_' ~ sid ~ '_s_resume_days'] }}</div>{% endif %}
                    <div class="help-block">{{ help_resume_days }}</div>
                  </div>
                </div>
              </div>
              {% endfor %}
            </div>

            <!-- ============ APPEARANCE (per store) ============ -->
            <div class="tab-pane" id="tab-appearance">
              {% for store in stores %}{% set sid = store.store_id %}{% set s = store.s %}{% set p = 's_' ~ sid ~ '_' %}
              <div class="aichat-store aichat-appearance" data-store="{{ sid }}">
                <div class="row">
                  <div class="col-md-7 aichat-appearance-form">
                    <fieldset>
                      <legend>{{ text_colors }} <button type="button" class="btn btn-link btn-xs aichat-reset-appearance"><i class="fa fa-undo"></i> {{ button_reset_defaults }}</button></legend>
                      {% for k, label in {'s_color_accent': entry_color_accent, 's_color_header_bg': entry_color_header_bg, 's_color_header_text': entry_color_header_text, 's_color_user_bg': entry_color_user_bg, 's_color_user_text': entry_color_user_text} %}
                      <div class="form-group">
                        <label class="col-sm-4 control-label">{{ label }}</label>
                        <div class="col-sm-8">
                          <div class="aichat-colorrow">
                            <input type="color" class="aichat-colorpick" value="{{ attribute(s, k)|e('html_attr') }}" />
                            <input type="text" name="s[{{ sid }}][{{ k }}]" value="{{ attribute(s, k)|e('html_attr') }}" class="form-control aichat-colortext" maxlength="7" data-default="{{ attribute(factory, k) }}" data-pv="{{ k }}" />
                          </div>
                        </div>
                      </div>
                      {% endfor %}
                      <div class="help-block">{{ help_colors }}</div>
                    </fieldset>

                    <fieldset>
                      <legend>{{ text_launcher }}</legend>
                      <div class="form-group">
                        <label class="col-sm-4 control-label">{{ entry_launcher_style }}</label>
                        <div class="col-sm-8">
                          <select name="s[{{ sid }}][s_launcher_style]" class="form-control" data-default="avatar" data-pv="s_launcher_style">
                            <option value="avatar"{% if s.s_launcher_style == 'avatar' %} selected="selected"{% endif %}>{{ text_style_avatar }}</option>
                            <option value="avatar_text"{% if s.s_launcher_style == 'avatar_text' %} selected="selected"{% endif %}>{{ text_style_avatar_text }}</option>
                          </select>
                        </div>
                      </div>
                      {% for language in languages %}
                      <div class="form-group">
                        <label class="col-sm-4 control-label">{{ entry_launcher_text }} ({{ language.code }})</label>
                        <div class="col-sm-8"><input type="text" name="s[{{ sid }}][s_launcher_text][{{ language.language_id }}]" value="{{ s.s_launcher_text[language.language_id]|e('html_attr') }}" class="form-control aichat-launcher-text" data-default="" data-pv="s_launcher_text" placeholder="{{ text_launcher_text_default }}" /></div>
                      </div>
                      {% endfor %}
                      <div class="form-group">
                        <label class="col-sm-4 control-label">{{ entry_launcher_shape }}</label>
                        <div class="col-sm-8">
                          <select name="s[{{ sid }}][s_launcher_shape]" class="form-control" data-default="circle" data-pv="s_launcher_shape">
                            <option value="circle"{% if s.s_launcher_shape == 'circle' %} selected="selected"{% endif %}>{{ text_shape_circle }}</option>
                            <option value="rounded"{% if s.s_launcher_shape == 'rounded' %} selected="selected"{% endif %}>{{ text_shape_rounded }}</option>
                            <option value="pill"{% if s.s_launcher_shape == 'pill' %} selected="selected"{% endif %}>{{ text_shape_pill }}</option>
                          </select>
                        </div>
                      </div>
                      <div class="form-group">
                        <label class="col-sm-4 control-label">{{ entry_launcher_size }}</label>
                        <div class="col-sm-3"><div class="input-group"><input type="text" name="s[{{ sid }}][s_launcher_size]" value="{{ s.s_launcher_size|e('html_attr') }}" class="form-control" data-default="56" data-pv="s_launcher_size" /><span class="input-group-addon">px</span></div>
                          {% if errors[p ~ 's_launcher_size'] %}<div class="text-danger aichat-err">{{ errors[p ~ 's_launcher_size'] }}</div>{% endif %}</div>
                        <label class="col-sm-2 control-label">{{ entry_launcher_avatar_size }}</label>
                        <div class="col-sm-3"><div class="input-group"><input type="text" name="s[{{ sid }}][s_launcher_avatar_size]" value="{{ s.s_launcher_avatar_size|e('html_attr') }}" class="form-control" data-default="{{ factory.s_launcher_avatar_size }}" data-pv="s_launcher_avatar_size" /><span class="input-group-addon">px</span></div>
                          {% if errors[p ~ 's_launcher_avatar_size'] %}<div class="text-danger aichat-err">{{ errors[p ~ 's_launcher_avatar_size'] }}</div>{% endif %}</div>
                        <div class="col-sm-offset-4 col-sm-8"><div class="help-block">{{ help_launcher_size }}</div></div>
                      </div>
                    </fieldset>

                    <fieldset>
                      <legend>{{ text_position }}</legend>
                      {% for dev in ['desktop', 'mobile'] %}
                      <div class="form-group">
                        <label class="col-sm-4 control-label">{{ dev == 'desktop' ? entry_pos_desktop : entry_pos_mobile }}</label>
                        <div class="col-sm-3">
                          <select name="s[{{ sid }}][s_pos_{{ dev }}_side]" class="form-control" data-default="right" data-pv="s_pos_{{ dev }}_side">
                            <option value="right"{% if attribute(s, 's_pos_' ~ dev ~ '_side') == 'right' %} selected="selected"{% endif %}>{{ text_right }}</option>
                            <option value="left"{% if attribute(s, 's_pos_' ~ dev ~ '_side') == 'left' %} selected="selected"{% endif %}>{{ text_left }}</option>
                          </select>
                        </div>
                        <div class="col-sm-2"><div class="input-group"><span class="input-group-addon">X</span><input type="text" name="s[{{ sid }}][s_pos_{{ dev }}_x]" value="{{ attribute(s, 's_pos_' ~ dev ~ '_x')|e('html_attr') }}" class="form-control" data-default="20" data-pv="s_pos_{{ dev }}_x" /></div></div>
                        <div class="col-sm-2"><div class="input-group"><span class="input-group-addon">Y</span><input type="text" name="s[{{ sid }}][s_pos_{{ dev }}_y]" value="{{ attribute(s, 's_pos_' ~ dev ~ '_y')|e('html_attr') }}" class="form-control" data-default="20" data-pv="s_pos_{{ dev }}_y" /></div></div>
                        {% if errors[p ~ 's_pos_' ~ dev ~ '_x'] or errors[p ~ 's_pos_' ~ dev ~ '_y'] %}<div class="col-sm-offset-4 col-sm-8 text-danger aichat-err">{{ errors[p ~ 's_pos_' ~ dev ~ '_x'] }} {{ errors[p ~ 's_pos_' ~ dev ~ '_y'] }}</div>{% endif %}
                      </div>
                      {% endfor %}
                      <div class="help-block">{{ help_position }}</div>
                      <div class="form-group">
                        <label class="col-sm-4 control-label">z-index</label>
                        <div class="col-sm-3"><input type="text" name="s[{{ sid }}][s_zindex]" value="{{ s.s_zindex|e('html_attr') }}" class="form-control" data-default="{{ factory.s_zindex }}" />
                          {% if errors[p ~ 's_zindex'] %}<div class="text-danger aichat-err">{{ errors[p ~ 's_zindex'] }}</div>{% endif %}</div>
                        <div class="col-sm-5"><div class="help-block">{{ help_zindex }}</div></div>
                      </div>
                    </fieldset>

                    <fieldset>
                      <legend>{{ text_attention }}</legend>
                      <div class="form-group">
                        <label class="col-sm-4 control-label" for="input-s{{ sid }}-attention">{{ entry_attention }}</label>
                        <div class="col-sm-3">
                          <select name="s[{{ sid }}][s_attention]" id="input-s{{ sid }}-attention" class="form-control" data-default="1">
                            <option value="1"{% if s.s_attention %} selected="selected"{% endif %}>{{ text_enabled }}</option>
                            <option value="0"{% if not s.s_attention %} selected="selected"{% endif %}>{{ text_disabled }}</option>
                          </select>
                        </div>
                        <label class="col-sm-2 control-label" for="input-s{{ sid }}-attint">{{ entry_attention_interval }}</label>
                        <div class="col-sm-3"><div class="input-group"><input type="text" name="s[{{ sid }}][s_attention_interval]" value="{{ s.s_attention_interval|e('html_attr') }}" id="input-s{{ sid }}-attint" class="form-control" data-default="5" /><span class="input-group-addon">{{ text_seconds }}</span></div>
                          {% if errors[p ~ 's_attention_interval'] %}<div class="text-danger aichat-err">{{ errors[p ~ 's_attention_interval'] }}</div>{% endif %}</div>
                        <div class="col-sm-offset-4 col-sm-8"><div class="help-block">{{ help_attention }}</div></div>
                      </div>
                    </fieldset>

                    <fieldset>
                      <legend>{{ text_custom_css }}</legend>
                      <textarea name="s[{{ sid }}][s_custom_css]" rows="4" class="form-control aichat-mono" data-default="" placeholder="#aichat-root .aichat-launcher { box-shadow: none; }">{{ s.s_custom_css|e }}</textarea>
                      <div class="help-block">{{ help_custom_css }}</div>
                    </fieldset>
                  </div>

                  <div class="col-md-5">
                    <div class="aichat-preview" data-store="{{ sid }}">
                      <h4>{{ text_preview }}</h4>
                      <div class="aichat-pv-panel">
