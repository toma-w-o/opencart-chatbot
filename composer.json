{
    "name": "aichat/opencart-aichat",
    "description": "AI shop-assistant chat for OpenCart 3.0.3.x (module code aichat)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=7.3"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.13",
        "phpcompatibility/php-compatibility": "10.0.0-alpha2",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint": [
            "phpcs -p -s --standard=PHPCompatibility --runtime-set testVersion 7.3 --extensions=php upload/ tests/",
            "@lint-syntax"
        ],
        "lint-syntax": "find upload tests -name '*.php' -print0 | xargs -0 -n1 php -l"
    },
    "minimum-stability": "alpha",
    "prefer-stable": true
}
